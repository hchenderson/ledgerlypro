{
  "name": "nextn",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev --turbopack -p 9002",
    "genkit:dev": "genkit start -- tsx src/ai/dev.ts",
    "genkit:watch": "genkit start -- tsx --watch src/ai/dev.ts",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project ledgerly-sec002-test \"vitest run --config vitest.rules.config.ts\"",
    "test:e2e:isolated": "LEDGERLY_RULES_PROFILE=proposed firebase emulators:exec --only auth,firestore --project ledgerly-release-demo \"tsx scripts/release-test/run-isolated-e2e.ts\"",
    "test:e2e:baseline": "LEDGERLY_RULES_PROFILE=baseline firebase emulators:exec --config firebase.release-baseline.json --only auth,firestore --project ledgerly-release-demo \"tsx scripts/release-test/run-isolated-e2e.ts\"",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test && npm run test:rules",
    "migration:data001:dry-run": "tsx scripts/data001-dry-run.ts"
  },

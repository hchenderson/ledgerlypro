rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Snapshot of firestore.rules at release base 4b34887. This is a source
    // reference only; equivalence to the currently deployed rules is unknown.
    match /users/{userId}/{collectionName}/{document=**} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId)
        && collectionName != "plaidItems"
        && collectionName != "balanceSnapshots";
    }

    match /plaidSecrets/{document=**} { allow read, write: if false; }
    match /plaidItemOwners/{document=**} { allow read, write: if false; }
    match /plaidWebhookInbox/{document=**} { allow read, write: if false; }
    match /plaidOperations/{document=**} { allow read, write: if false; }
    match /rateLimitBuckets/{document=**} { allow read, write: if false; }
  }
}
